# Chave da API do Google Gemini (https://aistudio.google.com/apikey)
# Sem essa chave o app roda em modo demonstração.
GEMINI_API_KEY=

# Domínio público do app (usado pelo Caddy para emitir o certificado HTTPS)
# Ex.: salve-minha-planta.seudominio.com
DOMAIN=

# Imagem publicada pelo CI no GitHub Container Registry (usada apenas na VPS)
# Ex.: ghcr.io/seu-usuario/salve-minha-planta:latest
IMAGE=
